// WARNING: open rules for development.
// Tighten before release.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      allow read, write: if true;

      match /votes/{uid} {
        match /ballot/{resId} {
          allow read, write: if true;
        }
      }
    }
  }
}
