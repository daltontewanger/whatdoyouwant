// Room data rules, used by the local emulators, staging and production.
// Rooms, memberships, decks, join codes, receipts and limits are written only
// by the room callables. Clients write nothing but their own immutable ballots
// and, for verified accounts, their own search defaults.
// Live-search config, weekly usage, the provider ledger, entitlements and deck
// generation leases are server-only and fall to the final deny.
//
// rooms/{id}: creator, status (lobby | voting | closed), memberCount, joinCode
//   (lobby only), deckId, candidateCount, votingEndsAt (from start), expiresAt,
//   results (after close)
// rooms/{id}/members/{uid}: uid, active, expiresAt
// rooms/{id}/votes/{uid}/ballot/{candidateId}: liked, at, expiresAt
// restaurantDecks/{id}: ownerUid, targetType (room | quickPick), targetId,
//   candidateIds, candidates, filter summary and pool report, expiresAt. Immutable.
// quickPicks/{id}: ownerUid, deckId, order, position, rerollsUsed, expiresAt.
// Every room document carries expiresAt for TTL cleanup; reads check it as well
// because TTL deletion can lag.
// userSettings/{uid}: unit, radius, deckSize, includedCuisineIds,
//   excludedCuisineIds, openNowPreferred, updatedAt. Kept until the account is
//   deleted (deleteAccount removes it). Never holds a location.
// userLists/{uid}: spots [{id, name, address?, note?}] the person typed (at
//   most 50), updatedAt. Written only by saveOwnList, which checks each spot;
//   kept until the account is deleted (deleteAccount removes it).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function roomDoc(room) {
      return get(/databases/$(database)/documents/rooms/$(room));
    }
    function member(room) {
      return request.auth != null &&
        get(/databases/$(database)/documents/rooms/$(room)/members/$(request.auth.uid)).data.active == true;
    }
    function live(room) {
      return roomDoc(room).data.expiresAt > request.time;
    }
    function deckOf(room) {
      return get(/databases/$(database)/documents/restaurantDecks/$(roomDoc(room).data.deckId));
    }
    // The room stays 'voting' until someone asks for results, so the deadline
    // has to be checked here as well.
    function votingOpen(room) {
      let data = roomDoc(room).data;
      return data.status == 'voting' && 'votingEndsAt' in data && request.time < data.votingEndsAt;
    }
    function validBallot(room, data) {
      return data.keys().hasAll(['liked', 'at', 'expiresAt']) &&
        data.keys().hasOnly(['liked', 'at', 'expiresAt']) &&
        data.liked is bool && data.at is timestamp && data.at == request.time &&
        data.expiresAt == roomDoc(room).data.expiresAt;
    }
    // Guests keep their defaults on the device: their accounts are removed
    // when idle, and unverified ones by the weekly cleanup, neither of which
    // touches Firestore.
    function verifiedAccount(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.auth.token.email_verified == true;
    }
    // The same IDs as rooms/search/cuisines.js; a unit test keeps them in step.
    function cuisineIds() {
      return ['african', 'american', 'chinese', 'french', 'greek_mediterranean', 'indian', 'italian', 'japanese', 'korean', 'latin_american', 'mexican', 'middle_eastern', 'thai', 'vietnamese', 'bbq', 'breakfast', 'burgers', 'chicken', 'dessert', 'fast_food', 'pizza', 'sandwiches', 'seafood', 'steakhouse'];
    }
    function cuisineList(list) {
      return list is list && list.size() <= 8 && list.toSet().size() == list.size() &&
        list.hasOnly(cuisineIds());
    }
    function validSettings(data) {
      let fields = ['unit', 'radius', 'deckSize', 'includedCuisineIds', 'excludedCuisineIds',
        'openNowPreferred', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&
        data.unit in ['mi', 'km'] &&
        data.radius is int && data.radius in [1, 3, 5, 10, 15] &&
        data.deckSize is int && data.deckSize in [5, 10, 15, 25] &&
        cuisineList(data.includedCuisineIds) && cuisineList(data.excludedCuisineIds) &&
        !data.includedCuisineIds.hasAny(data.excludedCuisineIds) &&
        data.openNowPreferred is bool && data.updatedAt == request.time;
    }
    match /rooms/{room} {
      allow get: if member(room) && live(room);
      allow list, create, update, delete: if false;
      match /members/{uid} {
        allow get: if member(room) && live(room) && request.auth.uid == uid;
        allow list, write: if false;
      }
      match /votes/{uid}/ballot/{candidateId} {
        allow read: if member(room) && live(room) && request.auth.uid == uid;
        allow create: if member(room) && live(room) && request.auth.uid == uid &&
          votingOpen(room) &&
          candidateId in deckOf(room).data.candidateIds &&
          validBallot(room, request.resource.data);
        // Votes are immutable; tallying and closing are server-owned.
        allow update, delete: if false;
      }
    }
    // Members of the room a deck was made for can read it while the room lives;
    // a Quick Pick deck only its owner.
    match /restaurantDecks/{deck} {
      allow get: if resource.data.expiresAt > request.time && (
        (resource.data.targetType == 'room' && member(resource.data.targetId) && live(resource.data.targetId)) ||
        (resource.data.targetType == 'quickPick' && request.auth != null &&
          resource.data.ownerUid == request.auth.uid));
      allow list, write: if false;
    }
    match /quickPicks/{pick} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid &&
        resource.data.expiresAt > request.time;
      allow list, write: if false;
    }
    match /userSettings/{uid} {
      allow get: if verifiedAccount(uid);
      allow create, update: if verifiedAccount(uid) && validSettings(request.resource.data);
      // Removed only with the account, by deleteAccount.
      allow list, delete: if false;
    }
    match /userLists/{uid} {
      allow get: if verifiedAccount(uid);
      allow list, write: if false;
    }
    // Favorites and never list: the verified owner reads; only saveMyPlaces
    // writes, after checking every entry.
    match /userPlaces/{uid} {
      allow get: if verifiedAccount(uid);
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
