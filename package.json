{
  "name": "whatdoyouwant-local-tools",
  "private": true,
  "scripts": {
    "local:preview": "node scripts/local.mjs preview",
    "test:unit": "node --test \"local-testing/*.test.cjs\"",
    "benchmark:search": "node local-testing/search/benchmark/run.cjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test:tooling": "node --test \"local-testing/tooling/*.test.cjs\"",
    "test:policy": "node scripts/local.mjs policy",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "devDependencies": {
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "@modelcontextprotocol/sdk": "1.32.1",
    "basic-ftp": "6.2.2"
  }
}
