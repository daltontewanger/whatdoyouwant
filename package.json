{
  "name": "whatdoyouwant-local-tools",
  "private": true,
  "scripts": {
    "local": "node scripts/local.mjs start",
    "local:preview": "node scripts/local.mjs preview",
    "test:local": "node scripts/local.mjs test",
    "test:unit": "node --test local-testing/unit.test.cjs local-testing/rooms-entry.test.cjs",
    "test:tooling": "node --test local-testing/tooling.test.cjs",
    "test:policy": "node scripts/local.mjs policy",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "devDependencies": {
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "@modelcontextprotocol/sdk": "1.32.1",
    "basic-ftp": "6.2.2"
  }
}
